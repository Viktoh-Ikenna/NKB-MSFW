      <when state="circum" output="&#x0186;&#x0302;"/>
      <when state="diaer" output="&#x0186;&#x0308;"/>
      <when state="cedil" output="&#x0186;&#x0327;"/>
      <when state="macron" output="&#x0186;&#x0304;"/>
    </action>
    <action id="su_eps">
      <when state="none" output="&#x0190;"/>
      <when state="cedil" output="&#x0190;&#x0327;"/>
    </action>
  </actions>
  <terminators>
    <when state="grave" output="&#x0060;"/>
    <when state="acute" output="&#x00B4;"/>
    <when state="tilde" output="&#x007E;"/>
    <when state="circum" output="&#x005E;"/>
    <when state="diaer" output="&#x00A8;"/>
    <when state="cedil" output="&#x00B8;"/>
    <when state="macron" output="&#x00AF;"/>
    <when state="stroke" output="&#x002F;"/>
    <when state="bar" output="&#x007C;"/>
  </terminators>
</keyboard>
