  <actions>
    <!-- dead-key entries: set the composing state -->
    <action id="dead_grave"><when state="none" next="grave"/></action>
    <action id="dead_acute"><when state="none" next="acute"/></action>
    <action id="dead_tilde"><when state="none" next="tilde"/></action>
    <action id="dead_circum"><when state="none" next="circum"/></action>
    <action id="dead_diaer"><when state="none" next="diaer"/></action>
    <action id="dead_cedil"><when state="none" next="cedil"/></action>
    <action id="dead_macron"><when state="none" next="macron"/></action>
    <action id="dead_stroke"><when state="none" next="stroke"/></action>
    <action id="dead_bar"><when state="none" next="bar"/></action>
